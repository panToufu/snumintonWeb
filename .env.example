# 서버에서만 사용하는 Supabase URL과 secret key입니다.
SUPABASE_URL=
# Supabase Dashboard > Settings > API Keys에서 생성한 secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# 기존 service_role 키를 이미 사용하는 경우에만 SUPABASE_SERVICE_ROLE_KEY= 로 대체 가능
# `npm run hash:password`로 생성하세요. `$` 대신 `:` 구분자를 사용합니다.
ADMIN_PASSWORD_HASH=scrypt:<salt>:<hash>
# 게스트 공용 확인 코드도 평문 대신 해시로 저장합니다.
GUEST_PASSWORD_HASH=scrypt:<salt>:<hash>
ADMIN_SESSION_SECRET=
ADMIN_SESSION_VERSION=1
